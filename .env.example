# ─────────────────────────────────────────────────────────────────────────────
# Environment Variables — portfolio-v1
#
# Copy this file to .env.local and fill in values.
# Never commit .env.local or any file containing real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_NAME="Shubham Nagula"

# ─── Contact Form ─────────────────────────────────────────────────────────────
# Provider: Resend / SendGrid / Nodemailer
CONTACT_EMAIL_TO=your@email.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ─── Analytics ────────────────────────────────────────────────────────────────
# Provider: Plausible / Vercel Analytics / PostHog
NEXT_PUBLIC_ANALYTICS_ID=

# ─── GitHub Integration ───────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_GITHUB_USERNAME=your-github-username

# ─── Newsletter ───────────────────────────────────────────────────────────────
# Provider: ConvertKit / Buttondown / Loops
NEWSLETTER_API_KEY=
NEWSLETTER_FORM_ID=

# ─── CMS (Phase 2+) ───────────────────────────────────────────────────────────
# Provider: Sanity / Contentlayer / MDX
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=
